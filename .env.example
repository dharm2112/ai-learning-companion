# Copy this file to .env and replace the placeholder with your Groq API key.
# Never commit .env or share its contents.
GROQ_API_KEY=XYZ
GROQ_MODEL=openai/gpt-oss-20b

# --- Adaptive AI Learning System (new) ---
# SQLite database path (default: ./data/learning.db)
DB_PATH=./data/learning.db

# ChromaDB vector store path (default: ./data/chroma)
CHROMA_PATH=./data/chroma

# Optional HuggingFace Hub token. Public embedding models do not require one.
HUGGINGFACEHUB_API_TOKEN=

# Sentence-transformers model for embeddings (default: all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2
